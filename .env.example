# ONYX Exchange — copy to .env.local
# See supabase/README.md for full setup.

# Required (client + server)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Required in production for canonical URLs, sitemap, and Open Graph
NEXT_PUBLIC_APP_URL=https://onyxmarkets.site

# Optional branding (defaults to ONYX in constants.ts)
NEXT_PUBLIC_APP_NAME=ONYX

# Server/scripts only — never expose to the browser
# Used by: npm run create-admin, daily meme coin cron
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional — CoinGecko demo/pro API key (higher rate limits for trending imports)
COINGECKO_API_KEY=

# Required in production for Vercel cron auth (Authorization: Bearer <secret>)
CRON_SECRET=your_random_cron_secret
